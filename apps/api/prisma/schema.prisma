generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============ USER ============

enum AddressType {
  HOME
  OFFICE
}

enum AddressFormat {
  OLD
  NEW
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?
  name          String
  avatar        String?
  role          Role      @default(CUSTOMER)
  googleId      String?   @unique
  emailVerified Boolean   @default(false)
  points        Int       @default(0)
  referralCode  String?   @unique
  deletionRequestedAt DateTime?
  deletedAt     DateTime?
  isLocked      Boolean   @default(false)
  lockedAt      DateTime?
  lockReason    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  returnRequests ReturnRequest[]
  reviews       Review[]
  wishlist      Wishlist[]
  cart          Cart?
  pointHistory  PointHistory[]
  pushSubscriptions PushSubscription[]
  blogPosts     BlogPost[]
  referralsMade Referral[] @relation("referrer")
  referredBy    Referral?  @relation("referee")
  giftCardsPurchased GiftCard[] @relation("purchaser")
  giftCardsRedeemed  GiftCard[] @relation("redeemer")
  giftCardsBeneficiary GiftCard[] @relation("beneficiary")
  giftCardTransactions GiftCardTransaction[] @relation("giftCardTransactionUser")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone      String
  province   String
  district   String?
  ward       String
  provinceId Int?
  districtId Int?
  wardCode   String?
  street     String
  type       AddressType   @default(HOME)
  format     AddressFormat @default(NEW)
  isDefault  Boolean       @default(false)
  createdAt  DateTime      @default(now())

  orders Order[]
}

// ============ LOCATIONS ============
model Province {
  id        Int        @id
  name      String
  districts District[]
}

model District {
  id         Int      @id
  name       String
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  wards      Ward[]

  @@index([provinceId])
}

model Ward {
  code       String   @id
  name       String
  districtId Int
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId])
}

// ============ PRODUCT ============
model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  sizeGuide   SizeGuide?
  order       Int        @default(0)
}

model SizeGuide {
  id         String    @id @default(cuid())
  categoryId String?   @unique
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  data       Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Product {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String     @db.Text
  shortDesc   String?
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  collarType  CollarType
  material    String?
  basePrice   Decimal    @db.Decimal(12, 0)
  salePrice   Decimal?   @db.Decimal(12, 0)
  images      String[]
  thumbnail   String
  isActive    Boolean    @default(true)
  isFeatured  Boolean    @default(false)
  metaTitle       String?
  metaDescription String?
  soldCount   Int        @default(0)
  viewCount   Int        @default(0)
  rating      Float      @default(0)
  reviewCount Int        @default(0)
  lowStockThreshold Int  @default(5)
  isPreorder      Boolean   @default(false)
  preorderDate    DateTime?
  preorderLimit   Int?
  tags        String[]
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  variants     ProductVariant[]
  reviews      Review[]
  wishlistedBy Wishlist[]
  flashSaleItems FlashSaleItem[]
  bundleItems  BundleItem[]

  @@index([categoryId])
  @@index([collarType])
  @@index([isActive, isFeatured])
}

enum CollarType {
  CO_CO
  CO_TRON
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique
  size        Size
  color       String
  colorHex    String
  stock       Int      @default(0)
  reserved    Int      @default(0)
  safetyStock Int      @default(0)
  outletStock Int      @default(0)
  defectiveStock Int   @default(0)
  price       Decimal? @db.Decimal(12, 0)
  images      String[]
  isActive    Boolean  @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]
  stockNotifications StockNotification[]
  stockMovements StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

// ============ CART ============
model Cart {
  id                  String     @id @default(cuid())
  userId              String     @unique
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items               CartItem[]
  updatedAt           DateTime   @updatedAt
  lastReminderSentAt  DateTime?
  reminderCount       Int        @default(0)
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

// ============ ORDER ============
model Order {
  id              String        @id @default(cuid())
  code            String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?      @relation(fields: [addressId], references: [id])
  shippingName    String
  shippingPhone   String
  shippingAddress String
  subtotal        Decimal       @db.Decimal(12, 0)
  shippingFee     Decimal       @default(0) @db.Decimal(12, 0)
  discount        Decimal       @default(0) @db.Decimal(12, 0)
  total           Decimal       @db.Decimal(12, 0)
  pointsUsed      Int           @default(0)
  pointsEarned    Int           @default(0)
  voucherId       String?
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])
  voucherCode     String?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paymentRef      String?
  note            String?
  stockDeducted   Boolean       @default(false)
  stockRestored   Boolean       @default(false)
  reservedUntil   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  ghnOrderCode      String?
  toDistrictId      Int?
  toWardCode        String?
  estimatedDelivery DateTime?
  deletedAt         DateTime?

  items OrderItem[]
  returnRequests ReturnRequest[]
  invoice Invoice?
  giftCardTransactions GiftCardTransaction[]

  @@index([userId])
  @@index([status])
  @@index([code])
}

model OrderItem {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  productName       String
  productSlug       String
  variantName       String
  image             String
  price             Decimal        @db.Decimal(12, 0)
  quantity          Int
  subtotal          Decimal        @db.Decimal(12, 0)
  discountAllocated Decimal        @default(0) @db.Decimal(12, 0)
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  INSPECTING
  REFUNDED
  COMPLETED
}

model ReturnRequest {
  id           String       @id @default(cuid())
  code         String       @unique
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ReturnType
  status       ReturnStatus @default(PENDING)
  reason       String
  description  String?
  images       String[]
  items        Json
  refundAmount Decimal?     @db.Decimal(12, 0)
  adminNote    String?
  qcResults    Json?
  stockProcessed Boolean    @default(false)
  refundProcessed Boolean   @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  STRIPE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============ VOUCHER ============
model Voucher {
  id                    String      @id @default(cuid())
  code                  String      @unique
  description           String?
  type                  VoucherType
  value                 Decimal     @db.Decimal(12, 0)
  minOrder              Decimal?    @db.Decimal(12, 0)
  maxDiscount           Decimal?    @db.Decimal(12, 0)
  usageLimit            Int?
  usageCount            Int         @default(0)
  perUserLimit          Int         @default(1)
  applicableCategoryIds String[]
  applicableProductIds  String[]
  requiredMemberTier    String?
  startsAt              DateTime
  expiresAt             DateTime
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())

  orders Order[]
}

enum VoucherType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

// ============ REVIEW ============
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String?
  content   String?
  images    String[]
  isApproved Boolean @default(false)
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

// ============ WISHLIST ============
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ============ LOYALTY ============
model PointHistory {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  type        PointType
  description String?
  orderId     String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

enum PointType {
  EARN_ORDER
  REDEEM
  BONUS
  EXPIRED
}

// ============ PUSH NOTIFICATION ============
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model StockNotification {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email     String
  userId    String?
  notified  Boolean        @default(false)
  notifiedAt DateTime?
  createdAt DateTime       @default(now())

  @@unique([variantId, email])
  @@index([variantId])
}

// ============ FLASH SALE ============
model FlashSale {
  id        String          @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  items     FlashSaleItem[]
}

model FlashSaleItem {
  id          String    @id @default(cuid())
  flashSaleId String
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  salePrice   Decimal   @db.Decimal(12, 0)
  quantity    Int
  sold        Int       @default(0)

  @@index([flashSaleId])
}

// ============ BLOG ============
model BlogCategory {
  id    String     @id @default(cuid())
  slug  String     @unique
  name  String
  posts BlogPost[]
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  content     String        @db.Text
  thumbnail   String?
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id])
  tags        String[]
  viewCount   Int           @default(0)
  metaTitle   String?
  metaDescription String?
  relatedProductIds String[]
  readingTime   Int?
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
}

// ============ REFERRAL ============
model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("referrer", fields: [referrerId], references: [id])
  refereeId     String   @unique
  referee       User     @relation("referee", fields: [refereeId], references: [id])
  orderId       String?
  refereeOrderId String?
  rewarded      Boolean  @default(false)
  rewardGiven   Boolean  @default(false)
  rewardAmount  Decimal? @db.Decimal(12, 0)
  createdAt     DateTime @default(now())

  @@index([referrerId])
}

// ============ NEWSLETTER ============
model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============ TAILORING REQUEST (Đặt may theo yêu cầu) ============
model TailoringRequest {
  id           String   @id @default(cuid())
  requestType  String   @default("CUSTOM") // CUSTOM | BULK (đồng phục/team building)
  name         String
  phone        String
  email        String?
  company      String?  // tên công ty/đội nhóm (đơn số lượng lớn)
  quantity     Int?     // số lượng dự kiến (đơn số lượng lớn)
  requirements String   @db.Text
  status       String   @default("NEW") // NEW | CONTACTED | DONE | CANCELLED
  adminNote    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([requestType])
  @@index([createdAt])
}


// ============ SETTINGS ============
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
// ============ BANNER ============
model Banner {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String?
  position  String   @default("home_hero")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

// ============ INVOICE ============
model Invoice {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber  String?
  invoiceSerial  String?
  invoiceDate    DateTime?
  buyerName      String
  buyerAddress   String
  buyerTaxCode   String?
  totalAmount    Decimal       @db.Decimal(12, 0)
  vatAmount      Decimal       @db.Decimal(12, 0)
  status         InvoiceStatus @default(DRAFT)
  pdfUrl         String?
  errorMessage   String?
  createdAt      DateTime      @default(now())
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
  ERROR
}

// ============ BUNDLE ============
model Bundle {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  description   String?
  thumbnail     String?
  discountType  VoucherType
  discountValue Decimal      @db.Decimal(12, 0)
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  items         BundleItem[]
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([bundleId, productId])
}

// ============ GIFT CARD ============
enum GiftCardStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum GiftCardSource {
  ADMIN_GRANT
  COMPENSATION
  CUSTOMER_SERVICE
  PURCHASE
  REFUND
  PROMOTION
}

enum GiftCardTransactionType {
  ISSUE
  REDEEM
  USE
  REFUND
  CANCEL
  ADJUST
  EXPIRE
}

model GiftCard {
  id                String         @id @default(cuid())
  code              String         @unique
  amount            Decimal        @db.Decimal(12, 0)
  balance           Decimal        @db.Decimal(12, 0)
  status            GiftCardStatus @default(ACTIVE)
  source            GiftCardSource @default(ADMIN_GRANT)
  purchaserId       String?
  purchaser         User?          @relation("purchaser", fields: [purchaserId], references: [id])
  beneficiaryUserId String?
  beneficiary       User?          @relation("beneficiary", fields: [beneficiaryUserId], references: [id])
  recipientEmail    String?
  recipientName     String?
  message           String?
  isActive          Boolean        @default(true)
  redeemedById      String?
  redeemedBy        User?          @relation("redeemer", fields: [redeemedById], references: [id])
  redeemedAt        DateTime?
  startsAt          DateTime?
  expiresAt         DateTime
  createdByAdminId  String?
  internalNote      String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  usedAt            DateTime?

  transactions      GiftCardTransaction[]

  @@index([beneficiaryUserId])
  @@index([redeemedById])
  @@index([status])
}

model GiftCardTransaction {
  id            String                  @id @default(cuid())
  giftCardId    String
  giftCard      GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type          GiftCardTransactionType
  amount        Decimal                 @db.Decimal(12, 0)
  balanceBefore Decimal?                @db.Decimal(12, 0)
  balanceAfter  Decimal?                @db.Decimal(12, 0)
  orderId       String?
  order         Order?                  @relation(fields: [orderId], references: [id])
  userId        String?
  user          User?                   @relation("giftCardTransactionUser", fields: [userId], references: [id])
  adminId       String?
  note          String?
  createdAt     DateTime                @default(now())

  @@index([giftCardId])
  @@index([orderId])
  @@index([userId])
}

// ============ STOCK MOVEMENT (Audit Ledger) ============
enum StockMovementType {
  RESERVE
  RELEASE
  COMMIT_SALE
  DEDUCT_DIRECT
  RESTOCK_CANCEL
  RESTOCK_RETURN_A
  RETURN_B_OUTLET
  WRITE_OFF
  MANUAL_ADJUST
  RESTOCK_INBOUND
  DISPOSE_DEFECTIVE
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  stockAfter  Int
  reservedAfter Int
  refType     String?
  refId       String?
  note        String?
  createdBy   String?
  createdAt   DateTime          @default(now())

  @@index([variantId])
  @@index([refType, refId])
  @@index([type])
}

