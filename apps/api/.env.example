# Local dev DB. Copy this file to .env and adjust credentials to match your Postgres setup.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/minh_tien_fashion?connection_limit=20&pool_timeout=10"
# Direct URL (bypasses connection pooler) - used for migrations
# In production with PgBouncer: DATABASE_URL points to PgBouncer (port 6432), DIRECT_DATABASE_URL points to Postgres directly (port 5432)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/minh_tien_fashion"
# Separate database for running tests — MUST be different from DATABASE_URL.
# Tests wipe this DB on every run, so never point it at your dev/prod data.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/minh_tien_fashion_test"
REDIS_URL="redis://localhost:6379"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="dev-master-key"
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

