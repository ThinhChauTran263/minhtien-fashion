{
    "name":  "@mtf/api",
    "version":  "1.0.0",
    "main":  "dist/index.js",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "build":  "tsc \u0026\u0026 prisma generate",
                    "start":  "node dist/index.js",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate dev",
                    "db:deploy":  "prisma migrate deploy",
                    "db:seed":  "tsx prisma/seed.ts",
                    "db:studio":  "prisma studio",
                    "search:sync-products":  "tsx scripts/sync-products-to-meilisearch.ts",
                    "test":  "node --localstorage-file=.jest-localstorage ../../node_modules/jest/bin/jest.js --config jest.config.ts --runInBand",
                    "test:watch":  "node --localstorage-file=.jest-localstorage ../../node_modules/jest/bin/jest.js --config jest.config.ts --watch",
                    "test:coverage":  "node --localstorage-file=.jest-localstorage ../../node_modules/jest/bin/jest.js --config jest.config.ts --coverage",
                    "typecheck":  "tsc --noEmit",
                    "test:ci":  "node --localstorage-file=.jest-localstorage ../../node_modules/jest/bin/jest.js --config jest.config.ts --runInBand --coverage --forceExit --no-cache"
                },
    "prisma":  {
                   "seed":  "tsx prisma/seed.ts"
               },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1057.0",
                         "@aws-sdk/client-ses":  "^3.1057.0",
                         "@aws-sdk/s3-request-presigner":  "^3.1057.0",
                         "@prisma/client":  "^5.18.0",
                         "@sentry/node":  "^10.55.0",
                         "@types/streamifier":  "^0.1.2",
                         "bcryptjs":  "^2.4.3",
                         "bullmq":  "^5.77.7",
                         "cloudinary":  "^2.10.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "exceljs":  "^4.4.0",
                         "express":  "^4.19.2",
                         "express-mongo-sanitize":  "^2.2.0",
                         "express-rate-limit":  "^7.4.0",
                         "firebase-admin":  "^13.10.0",
                         "google-auth-library":  "^10.6.2",
                         "helmet":  "^7.1.0",
                         "ioredis":  "^5.4.1",
                         "jsonwebtoken":  "^9.0.2",
                         "meilisearch":  "^0.58.0",
                         "multer":  "^2.1.1",
                         "node-cron":  "^4.2.1",
                         "nodemailer":  "^8.0.10",
                         "passport":  "^0.7.0",
                         "passport-google-oauth20":  "^2.0.0",
                         "pdfkit":  "^0.18.0",
                         "qrcode":  "^1.5.4",
                         "sharp":  "^0.33.2",
                         "streamifier":  "^0.1.1",
                         "web-push":  "^3.6.7",
                         "winston":  "^3.19.0",
                         "xss":  "^1.0.15",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/jest":  "^30.0.0",
                            "@types/jsonwebtoken":  "^9.0.6",
                            "@types/multer":  "^2.1.0",
                            "@types/node":  "^20.14.0",
                            "@types/nodemailer":  "^8.0.0",
                            "@types/pdfkit":  "^0.17.6",
                            "@types/qrcode":  "^1.5.6",
                            "@types/supertest":  "^7.2.0",
                            "@types/web-push":  "^3.6.4",
                            "jest":  "^30.4.2",
                            "prisma":  "^5.18.0",
                            "supertest":  "^7.2.2",
                            "ts-jest":  "^29.4.11",
                            "tsx":  "^4.16.0",
                            "typescript":  "^5.5.0"
                        }
}
